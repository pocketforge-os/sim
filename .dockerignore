# Keep the build context lean + reproducible: exclude VCS, regenerable baselines, build outputs.
.git
**/baseline/
# The generic checker consumes its tiny committed golden images inside the runtime image.
!generic/baseline/
!generic/baseline/**
**/build/
sdl3/SDL/
**/__pycache__/
**/*.pyc
*.img
*.img.xz
docker/baseline/

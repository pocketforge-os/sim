#!/usr/bin/env bash
# sim — the one-command developer CLI for the PocketForge virtual device simulator.
#
# Wraps the PINNED, reproducible `pocketforge-sim` container (built from committed refs — qemu-tsp +
# both SDL3 variants + an arm64 rootfs + the compiled apps + the platform descriptors) so a developer
# gets an AVD-style loop with ZERO hand-set env vars and ZERO host toolchain:
#
#     ./sim run a133        # boot one virtual device, run its headless logical suite
#     ./sim gui a133        # the clickable .scad-rendered skin (deprecated: pfvd --platform <checkout>)
#     ./sim check           # the full CI matrix (data-driven from platform), exactly as sim-gate.yml runs it
#
# It is a THIN, honest wrapper: every command below is the same container entrypoint (`pf-sim …`) the
# CI gate runs, invoked with the exact caps the nested bwrap+qemu-tsp sim needs (docker/README.md, the
# tsp-qc1.2 nesting verdict). Read docs/HONESTY-CONTRACT.md — the sim proves the LOGICAL layer only.
#
# Dependency-light on PURPOSE: POSIX-ish bash + docker. No python, no venv, no pip. infra-113 C1 (D7).
set -euo pipefail

# ── locate the repo root (this script lives at the repo root) ─────────────────────────────────────
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# ── image tags + the pinned container caps (single source of truth) ───────────────────────────────
IMAGE="${SIM_IMAGE:-pocketforge-sim}"          # base (headless CI) image tag; override for CI run-id tags
DEMO_IMAGE="${SIM_DEMO_IMAGE:-pocketforge-sim:demo}"
# The CI matrix is DATA-DRIVEN (infra-113 B4 / D6): `sim check` with no device args derives the
# device list + per-device posture (blocking|advisory|excluded) from the BAKED platform's
# ci-matrix.toml via `pf-sim matrix`, so there is NO hardcoded device list here or in sim-gate.yml.
# Adding a device to CI = adding platform data (a descriptor auto-joins as advisory), never a
# workflow edit.

# The nested-sim caps (docker/README.md) are only for bwrap namespaces and mount/pivot_root. Input
# is a container-private FIFO directory: no host /dev/input bind, /dev/uinput, or device wildcard.
SIM_CAPS=(
  --cap-add SYS_ADMIN
  --security-opt apparmor=unconfined
  --security-opt seccomp=unconfined
)

# ── pretty output (honors NO_COLOR + non-tty) ─────────────────────────────────────────────────────
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; CYN=$'\033[36m'; RST=$'\033[0m'
else
  BOLD=''; DIM=''; RED=''; GRN=''; YEL=''; CYN=''; RST=''
fi
info() { printf '%s\n' "${DIM}sim:${RST} $*" >&2; }
step() { printf '%s\n' "${CYN}${BOLD}==>${RST} ${BOLD}$*${RST}" >&2; }
warn() { printf '%s\n' "${YEL}sim: warning:${RST} $*" >&2; }
die()  { printf '%s\n' "${RED}sim: error:${RST} $*" >&2; exit "${2:-1}"; }

# ── preflight: each failure names the exact fix ───────────────────────────────────────────────────
need_docker() {
  command -v docker >/dev/null 2>&1 || die "docker is not installed.
    Fix: install Docker Engine — https://docs.docker.com/engine/install/  (then re-run)."
  if ! docker info >/dev/null 2>&1; then
    if docker info 2>&1 | grep -qiE 'permission denied|dial unix.*permission'; then
      die "cannot talk to the docker daemon (permission denied).
    Fix: add yourself to the 'docker' group — 'sudo usermod -aG docker \$USER' then log out/in,
         or run this command under sudo."
    fi
    die "the docker daemon is not reachable.
    Fix: start it — 'sudo systemctl start docker' (or launch Docker Desktop) — then re-run."
  fi
}
# The nested sim runs as root INSIDE the container (PID-1 root), so no host root is needed for the app
# itself — only docker access (checked above). We surface this explicitly so "root missing" is never a
# mystery: if docker needs sudo on this host, need_docker already said so.

# ── image build (cached; a no-op rebuild is fast) ─────────────────────────────────────────────────
build_base() {
  step "Building ${IMAGE} (pinned, reproducible-from-clean — cached layers make repeat builds fast)"
  docker build -t "$IMAGE" "$HERE" >&2
}
build_demo() {
  step "Building ${DEMO_IMAGE} (base + video SDL3/X11 + Xvfb — the clickable-skin demo image)"
  docker build --target demo -t "$DEMO_IMAGE" "$HERE" >&2
}

# ── device discovery + validation (a clean error beats a container traceback) ─────────────────────
list_devices() { # <image> — the device ids that ship a descriptor in the image
  docker run --rm -- "${1:-$IMAGE}" shell -lc 'ls -1 /opt/pf/platform/devices 2>/dev/null | sort' 2>/dev/null
}
validate_devices() { # <image> <devices...> — die with a helpful list on an unknown device
  local img="$1"; shift
  local avail; avail="$(list_devices "$img")"
  [ -n "$avail" ] || return 0   # probe failed → don't block; the suite will surface any real problem
  local d
  for d in "$@"; do
    printf '%s\n' "$avail" | grep -qxF "$d" || die "unknown device '$d'. This image ships: $(echo $avail | tr '\n' ' ')
    List them any time with: ./sim devices"
  done
}

# ── the headless logical suites (the SAME entrypoints CI runs) ────────────────────────────────────
# network none: the suite runs entirely from baked, pinned artifacts (docker/README.md) — proving the
# honest-offline property AND shrinking blast radius. Set SIM_NETWORK=1 to re-enable if ever needed.
_net=(); [ "${SIM_NETWORK:-0}" = "1" ] || _net=(--network none)
run_suite() { # <suite> <devices...>
  local suite="$1"; shift
  step "pf-sim check-${suite} $*  ${DIM}(native x86 == arm64-under-qemu-tsp, byte-identical)${RST}"
  docker run --rm "${_net[@]}" "${SIM_CAPS[@]}" -- "$IMAGE" "check-${suite}" "$@"
}
# Device-free blocking pre-passes. They run exactly once per `./sim check`, before any posture rows,
# so the developer command and CI gate cannot drift and advisory rows do not duplicate their cost.
# The shell suite exercises the image's pinned, freshly-built pf-shell under qemu-tsp, including a
# real --sim-frame render/composite assertion; the descriptor negative control remains cheap (~1s).
run_blocking_prepasses() {
  step "pf-sim selftest-skin-optional  ${DIM}(device-free: optional descriptor fields, tsp-bu5e)${RST}"
  docker run --rm "${_net[@]}" -- "$IMAGE" selftest-skin-optional
  step "pf-sim check-shell  ${DIM}(F12: pinned pf-shell + modeled lifecycle + --sim-frame composite)${RST}"
  docker run --rm "${_net[@]}" "${SIM_CAPS[@]}" -- "$IMAGE" check-shell
}
run_suites_over() { # <devices...> — control+sensor+skin over the devices; return rc (no build/validate)
  local suite rc=0
  for suite in control sensor skin generic; do
    run_suite "$suite" "$@" || rc=$?
  done
  return "$rc"
}
run_headless() { # <devices...> — build+validate, run the full matrix HARD (failure => nonzero)
  need_docker; build_base; validate_devices "$IMAGE" "$@"
  local rc=0
  run_blocking_prepasses || rc=$?
  run_suites_over "$@" || rc=$?
  if [ "$rc" -eq 0 ]; then printf '%s\n' "${GRN}${BOLD}✓ ALL SUITES PASS${RST} (control + sensor + skin) for: $*" >&2
  else printf '%s\n' "${RED}${BOLD}✗ suite failure${RST} (exit ${rc}) — see the FAIL lines above" >&2; fi
  return "$rc"
}

# ── data-driven matrix (infra-113 B4 / D6): derive device rows + posture from the baked platform ──
matrix_ids() { # <posture> — space-separated device ids at that posture, from the image's ci-matrix
  # `|| true`: a pre-B4 baked platform has no `matrix` subcommand -> the entrypoint verb execs
  # caps.py which exits 2; we must NOT let that nonzero status kill the caller under `set -e`
  # (it would skip the fail-closed fallback). Empty output => the fallback runs.
  docker run --rm -- "$IMAGE" matrix list --posture "$1" --format ids 2>/dev/null || true
}
caps_descriptor_devices() { # descriptor'd devices in the image (NOT all devices/ dirs) — for the
  # fail-closed fallback: profile-only dirs (a133-owned/sdm845) have no descriptor and must not run.
  docker run --rm -- "$IMAGE" shell -lc 'python3 /opt/pf/platform/core/caps.py list' 2>/dev/null | tr '\n' ' ' || true
}

# ── commands ──────────────────────────────────────────────────────────────────────────────────────
cmd_run() {
  [ $# -ge 1 ] || die "usage: sim run <device>   (e.g. sim run a133)   — one device's headless suite"
  [ $# -eq 1 ] || die "sim run takes exactly ONE device (got: $*). For the full matrix use 'sim check'."
  run_headless "$1"
}

cmd_check() { # the full CI matrix, exactly as sim-gate.yml runs it (data-driven, posture-aware)
  local rm_image=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --rm-image) rm_image=1; shift ;;   # CI convenience: drop the built image afterward
      --) shift; break ;;
      -*) die "sim check: unknown flag '$1'" ;;
      *) break ;;
    esac
  done
  local rc=0
  if [ $# -gt 0 ]; then
    # EXPLICIT device args (developer override): run exactly those, HARD — a dev asking for a
    # device wants to see real failures, so posture does not soften an explicit request.
    run_headless "$@" || rc=$?
  else
    # DATA-DRIVEN default (infra-113 B4 / D6): the device list + posture come from the baked
    # platform ci-matrix.toml — NOT a hardcoded list. blocking-device failures BLOCK (nonzero
    # exit => the required check goes red); advisory-device failures REPORT but do not block;
    # excluded devices never run. Adding a device = adding platform data, never editing this CLI.
    need_docker; build_base
    local blocking advisory excluded
    blocking="$(matrix_ids blocking)"; advisory="$(matrix_ids advisory)"; excluded="$(matrix_ids excluded)"
    if [ -z "$blocking$advisory" ]; then
      # FAIL-CLOSED fallback: the baked platform predates infra-113 B4 (no ci-matrix.toml /
      # no `matrix` subcommand). Derive the device list from platform data anyway (`caps list` =
      # the DESCRIPTOR'd devices in the image, excluding profile-only dirs) and gate them ALL as
      # blocking (pre-B4 behavior) — a stale pin never SILENTLY relaxes a device. Still list-free.
      blocking="$(caps_descriptor_devices)"; advisory=""; excluded=""
      warn "baked platform has no ci-matrix.toml (pin predates infra-113 B4) — all descriptor'd devices treated BLOCKING until the pin catches up"
    fi
    step "CI matrix (data-driven from platform ci-matrix.toml):"
    printf '%s\n' "  ${BOLD}blocking${RST} (a failure BLOCKS): ${blocking:-${DIM}(none)${RST}}" >&2
    printf '%s\n' "  ${BOLD}advisory${RST} (a failure REPORTS): ${advisory:-${DIM}(none)${RST}}" >&2
    printf '%s\n' "  ${DIM}excluded (not run): ${excluded:-(none)}${RST}" >&2
    [ -n "$blocking$advisory" ] || die "the CI matrix derived ZERO runnable devices — check platform ci-matrix.toml (pf caps matrix validate)."
    run_blocking_prepasses || rc=$?
    if [ -n "$blocking" ]; then
      validate_devices "$IMAGE" $blocking
      run_suites_over $blocking || rc=$?
      if [ "$rc" -eq 0 ]; then printf '%s\n' "${GRN}${BOLD}✓ BLOCKING suites pass${RST} for: $blocking" >&2
      else printf '%s\n' "${RED}${BOLD}✗ BLOCKING suite failure${RST} (exit ${rc}) for: $blocking — merge is blocked" >&2; fi
    fi
    if [ -n "$advisory" ]; then
      validate_devices "$IMAGE" $advisory
      local arc=0
      run_suites_over $advisory || arc=$?
      if [ "$arc" -eq 0 ]; then printf '%s\n' "${GRN}${BOLD}✓ ADVISORY suites pass${RST} for: $advisory" >&2
      else printf '%s\n' "${YEL}${BOLD}⚠ ADVISORY suite failure${RST} (exit ${arc}) for: $advisory — REPORTED, does not block merge" >&2; fi
    fi
  fi
  [ "$rm_image" = "1" ] && { docker image rm -f "$IMAGE" >/dev/null 2>&1 || true; }
  return "$rc"
}

# D9: the 2D skin window is deprecated in favour of pfvd's 3D window (pocketforge-os/pfvd). Printed
# by `sim gui` before anything else and in the help. tsp-ihne1.56.5: the host-display projection is
# removed — `sim gui` runs the container's autonomous private-Xvfb window-selftest, never a host window.
GUI_DEPRECATION="./sim gui is deprecated: use pfvd, the 3D device simulator (pfvd --platform <platform checkout>; https://github.com/pocketforge-os/pfvd). sim gui runs the container's private-display window-selftest."

cmd_gui() {
  local device="${1:-a133}"
  warn "$GUI_DEPRECATION"
  need_docker; build_demo; validate_devices "$DEMO_IMAGE" "$device"
  # tsp-ihne1.56.5 (uinput incident PR5): `sim gui` NEVER projects onto the host display. There is
  # no host X11 passthrough of any kind (no display or cookie env forwarding, no X socket bind, no
  # host access-control changes) — the only window route is the container's OWN Xvfb :99 selftest
  # (a private display), or pfvd.
  step "sim gui ${device} — window-selftest (private Xvfb :99 in the container): live window + click->light driver loop"
  docker run --rm "${SIM_CAPS[@]}" -- "$DEMO_IMAGE" window-selftest "$device"
}

# The in-container paths a caller's --fb0-path / --fb0-hdr-path files are bind-mounted at.
# generic_capture.py hands them to the harness as FB0_BIND / FB0_HDR_BIND, so bwrap binds them at
# /dev/fb0 and /dev/fb0.hdr (docs/FB0-SIDECAR.md).
RUN_APP_FB0=/run/pfvd/fb0
RUN_APP_FB0_HDR=/run/pfvd/fb0.hdr
# Where the image keeps its own arm64 apps (`bundled:<name>` -> $BUNDLED_DIR/<name>.arm64).
BUNDLED_DIR=/opt/pf/apps

# check_shared_file <flag> <host-path> <fix-hint>: one stat of the resolved path gives type, owner,
# mode and dev:ino from the same inode; dies unless the sandboxed app can map it read+write. Sets
# shared_real and shared_ident. docker -v binds by path, so the dev:ino goes to generic_capture,
# which refuses a file swapped in before the bind (docs/FB0-SIDECAR.md "Check, then bind").
check_shared_file() {
  local flag="$1" path="$2" hint="$3" uid="" gid="" mode="" ident="" type="" class bits real
  real="$(readlink -f -- "$path")" &&
    read -r uid gid mode ident type < <(stat -L -c '%u %g %a %d:%i %F' -- "$real" 2>/dev/null) || true
  case "$type" in "regular file"|"regular empty file") ;; *)
    die "$flag must name an existing regular file (got: $path)
    Fix: create it first, e.g. $hint" ;; esac
  # The sandboxed app is uid 0 / gid 0 with every capability dropped by bwrap: no DAC override,
  # so exactly one permission class applies (owner if root-owned, else group if gid 0, else other).
  if [ "$uid" = "0" ]; then class=u; bits=$(( (8#$mode >> 6) & 6 ))
  elif [ "$gid" = "0" ]; then class=g; bits=$(( (8#$mode >> 3) & 6 ))
  else class=o; bits=$(( 8#$mode & 6 )); fi
  [ "$bits" -eq 6 ] || die "$flag $real (owner $uid:$gid, mode $mode) is not readable+writable by the sandboxed app (uid 0 without capabilities).
    Fix: chmod $class+rw $real   (keep it inside a 0700 directory such as /run/user/\$(id -u)/pfvd)"
  shared_real="$real"; shared_ident="$ident"
}

cmd_run_app() {
  [ $# -ge 2 ] || die "usage: sim run-app <device> <arm64-binary|bundled:<name>> [--shot host.ppm] [--fb0-path file [--fb0-hdr-path file]] [--no-frame] [--print-cmd] [-- app-args]"
  local device="$1" app spec="$2"; shift 2
  local outdir; outdir="$(pwd)/sim-capture"
  local args=(--frame /out/frame.ppm); local docker_args=()
  if [[ "$spec" == bundled:* ]]; then
    # An app baked into the image: nothing from the host is bound; the entrypoint names a missing one.
    [[ "${spec#bundled:}" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "bundled:<name> takes an app name the image ships, e.g. bundled:fb-anim (got: $spec)"
    app="$BUNDLED_DIR/${spec#bundled:}.arm64"
  else
    app="$(readlink -f "$spec")"
    [ -f "$app" ] || die "arm64 binary not found: $app"
    docker_args+=(-v "$app:/run-app:ro"); app=/run-app
  fi
  docker_args+=(-v "$outdir:/out")
  # tsp-ihne1.56.5 (uinput incident PR5): caller-owned host evdev nodes and the live host-display
  # window route are REMOVED, not gated. Input is always the container-private modeled FIFO route;
  # the artifact route is the offscreen composite.
  local fb0_path="" fb0_hdr_path="" no_frame=0 print_cmd=0 shot=0 arg
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --shot) [ $# -gt 0 ] || die "--shot needs a host path"; shot=1; args+=(--shot "/out/$(basename "$1")"); shift ;;
      --fb0-path) [ $# -gt 0 ] || die "--fb0-path needs a host file (create it first, e.g. truncate -s \$((W*H*4)) <file>)"
        fb0_path="$1"; shift ;;
      --fb0-hdr-path) [ $# -gt 0 ] || die "--fb0-hdr-path needs a host file (create it first, e.g. truncate -s 64 <file>)"
        fb0_hdr_path="$1"; shift ;;
      --no-frame) no_frame=1 ;;
      --print-cmd) print_cmd=1 ;;
      --) args+=(-- "$@" ); break ;;
      *) die "sim run-app: unknown flag '$arg' (host input nodes and host-display windows were removed — tsp-ihne1.56.5; put app arguments after --)" ;;
    esac
  done
  local caps=("${SIM_CAPS[@]}")
  if [ "$no_frame" = "1" ]; then
    [ "$shot" = "0" ] || die "--no-frame writes no frame.ppm; --shot composites it (drop one)"
    args+=(--no-frame)
  fi
  # Screen: --fb0-path replaces generic_capture's private buffer with a caller-owned host file.
  # The caller sizes it; it is never created or truncated here.
  local shared_real="" shared_ident=""
  [ -z "$fb0_hdr_path" ] || [ -n "$fb0_path" ] || die "--fb0-hdr-path needs --fb0-path (the header describes your buffer)"
  if [ -n "$fb0_path" ]; then
    check_shared_file --fb0-path "$fb0_path" "truncate -s \$((W*H*4)) $fb0_path"
    fb0_path="$shared_real"
    docker_args+=(-v "$fb0_path:$RUN_APP_FB0")
    local hdr_args=() fb0_ident="$shared_ident"
    if [ -n "$fb0_hdr_path" ]; then
      # A second file, so fb0 stays a plain buffer: the in-container producer publishes the PFB0
      # seqlock header here and the caller reads it beside fb0 (docs/FB0-SIDECAR.md).
      check_shared_file --fb0-hdr-path "$fb0_hdr_path" "truncate -s 64 $fb0_hdr_path"
      [ "$shared_ident" != "$fb0_ident" ] || die "--fb0-hdr-path $shared_real is the same file as --fb0-path: the header would overwrite pixels"
      docker_args+=(-v "$shared_real:$RUN_APP_FB0_HDR")
      hdr_args=(--fb0-hdr "$RUN_APP_FB0_HDR" --fb0-hdr-ident "$shared_ident")
    fi
    args=(--fb0 "$RUN_APP_FB0" --fb0-ident "$fb0_ident" "${hdr_args[@]}" "${args[@]}")
  fi
  # --init: the capture supervisor would be PID 1, which ignores an unhandled SIGTERM, so `docker
  # stop` (and an app such as fb-anim that runs until SIGTERM) would wait out the stop timeout.
  local cmd=(docker run --rm --init "${caps[@]}" "${docker_args[@]}" -- "$DEMO_IMAGE" run-app "$device" "$app" "${args[@]}")
  if [ "$print_cmd" = "1" ]; then
    # Dry run: the exact argument list, shell-quoted on one line. No docker, no build, no mkdir.
    printf '%q' "${cmd[0]}"; printf ' %q' "${cmd[@]:1}"; printf '\n'
    return 0
  fi
  need_docker; build_demo; validate_devices "$DEMO_IMAGE" "$device"
  mkdir -p "$outdir"
  "${cmd[@]}"
  info "generic capture artifacts: $outdir"
}

cmd_devices() { # list the virtual devices this image can run (AVD-style discovery)
  need_docker; build_base
  step "virtual devices shipped in ${IMAGE}:"
  local d; list_devices "$IMAGE" | while read -r d; do printf '  %s%s%s\n' "${GRN}" "$d" "${RST}" >&2; done
}

cmd_build() {
  need_docker
  case "${1:-base}" in
    base) build_base ;;
    demo) build_demo ;;
    all)  build_base; build_demo ;;
    *) die "usage: sim build [base|demo|all]" ;;
  esac
}

cmd_shell() { # interactive debug shell inside the (base or demo) container
  need_docker
  local img="$IMAGE"; [ "${1:-}" = "demo" ] && { build_demo; img="$DEMO_IMAGE"; } || build_base
  step "interactive shell in ${img} (the nested sim caps are attached)"
  docker run --rm -it "${SIM_CAPS[@]}" -- "$img" shell
}

cmd_doctor() { # preflight only — the "is this host ready?" report
  local shell_suite=0
  if [ "${1:-}" = "--shell-suite" ]; then shell_suite=1; shift; fi
  [ $# -eq 0 ] || die "usage: sim doctor [--shell-suite]"
  step "sim doctor — host readiness for the virtual device simulator"
  local ok=1
  if command -v docker >/dev/null 2>&1; then printf '  %s docker installed (%s)\n' "${GRN}✓${RST}" "$(docker --version 2>/dev/null | awk '{print $3}' | tr -d ,)" >&2
    else printf '  %s docker NOT installed — https://docs.docker.com/engine/install/\n' "${RED}✗${RST}" >&2; ok=0; fi
  if docker info >/dev/null 2>&1; then printf '  %s docker daemon reachable (no sudo needed)\n' "${GRN}✓${RST}" >&2
    else printf '  %s docker daemon NOT reachable — start it or add yourself to the docker group\n' "${RED}✗${RST}" >&2; ok=0; fi
  printf '  %s input transport is container-private (host /dev/uinput not used)\n' "${GRN}✓${RST}" >&2
  printf '  %s display transport is container-private (sim gui uses its own Xvfb; no host X11 projection)\n' "${GRN}✓${RST}" >&2
  [ "$ok" = "1" ] || die "not ready — fix the ✗ items above."
  if [ "$shell_suite" = "1" ]; then
    build_base
    step "§15.2 shell suite — real arm64 launcher + authority core, MODELED cooperative transcripts"
    docker run --rm "${_net[@]}" "${SIM_CAPS[@]}" -- "$IMAGE" check-shell
  fi
  printf '%s\n' "${GRN}${BOLD}ready.${RST} Try: ./sim run a133" >&2
}

cmd_version() {
  local pc qc sp
  pc="$(sed -n 's/^commit *= *//p' "$HERE/docker/platform.pin" 2>/dev/null | head -1)"
  qc="$(sed -n 's/^ARG QEMU_TSP_COMMIT=//p' "$HERE/Dockerfile" 2>/dev/null | head -1)"
  sp="$(sed -n 's/^tag *= *//p' "$HERE/sdl3/SDL3.pin" 2>/dev/null | head -1)"
  printf '%s\n' "${BOLD}pocketforge sim CLI${RST} (infra-113 C1) — pinned toolchain:" >&2
  printf '  platform  %s\n' "${pc:-?}" >&2
  printf '  qemu-tsp  %s\n' "${qc:-?}" >&2
  printf '  SDL3      %s\n' "${sp:-?}" >&2
  printf '  image     %s  (demo: %s)\n' "$IMAGE" "$DEMO_IMAGE" >&2
}

usage() {
  cat >&2 <<EOF
${BOLD}sim${RST} — the PocketForge virtual device simulator, one command.

Run the ${BOLD}identical arm64 app the device runs${RST}, off-hardware, against a Virtual Device
Backend synthesized from the platform descriptor — the ${BOLD}logical layer${RST} proven in CI on every
PR. (What it does NOT prove — GPU, WiFi, timing, enforcement, per-SoC graphics — is the hardware
gate's job: see ${DIM}docs/HONESTY-CONTRACT.md${RST}.)

${BOLD}USAGE${RST}   ./sim <command> [args]

${BOLD}COMMANDS${RST}
  ${GRN}run${RST} <device>       Boot one virtual device, run its headless logical suite
                     (control + sensor + skin). e.g. ${DIM}./sim run a133${RST}
  ${GRN}gui${RST} [device]       The clickable-skin proof, headless and autonomous: the container runs a
                     live window + click->light driver loop on its OWN private Xvfb display.
                     Never projects onto the host display. ${DIM}default: a133${RST}
                     ${YEL}Deprecated: use pfvd${RST} (the 3D simulator): ${DIM}pfvd --platform <checkout>${RST}
  ${GRN}run-app${RST} <device> <arm64-bin|bundled:name> [--shot file.ppm] [-- args…]
                     Attach a generic /dev/fb0, run the binary under qemu-tsp, and composite its
                     pixels into the device skin. No app-specific snapshot protocol is required.
                     bundled:fb-anim runs the image's 60 Hz writer (also fb-pattern).
                     --fb0-path FILE: bind your pre-sized host file at /dev/fb0 (and
                     --fb0-hdr-path FILE: a 64-byte fb0.hdr beside it). --no-frame: no frame.ppm.
                     Input is always container-private and modeled. --print-cmd: print the
                     docker run argv and exit.
  ${GRN}check${RST} [devices…]   The ${BOLD}full CI matrix${RST}, exactly as sim-gate.yml runs it. With no
                     args the device list + per-device posture (blocking/advisory/excluded) are
                     ${BOLD}data-driven${RST} from platform's ci-matrix.toml; naming devices runs just those,
                     hard. This is the gate.
  ${GRN}devices${RST}            List the virtual devices this image can run.
  ${GRN}build${RST} [base|demo|all]   Build the pinned image(s) without running anything.
  ${GRN}shell${RST} [demo]       Interactive debug shell inside the container (caps attached).
  ${GRN}doctor${RST} [--shell-suite] Check readiness; optionally run §15.2 modeled shell cases.
  ${GRN}version${RST}            Show the pinned platform / qemu-tsp / SDL3 refs.

${BOLD}EXAMPLES${RST}
  ./sim doctor                 # is my host ready?  (says what to fix)
  ./sim run a133               # inner-loop: one device, headless
  ./sim gui a523               # bezel click->light proof on the container's private display
  ./sim check                  # what CI will decide — run before you push
  SIM_IMAGE=pocketforge-sim:ci-42 ./sim check --rm-image   # CI form (unique tag, clean up)

${BOLD}REQUIREMENTS${RST}  docker (in your group, or sudo). Host input devices are not used.
The nested sim runs as root ${BOLD}inside${RST} the container, so no host root is needed for the app.
Zero env vars to set — the image bakes every pinned path. ${DIM}HONESTY: docs/HONESTY-CONTRACT.md${RST}
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    run)     cmd_run "$@" ;;
    gui)     cmd_gui "$@" ;;
    run-app) cmd_run_app "$@" ;;
    check)   cmd_check "$@" ;;
    devices) cmd_devices "$@" ;;
    build)   cmd_build "$@" ;;
    shell)   cmd_shell "$@" ;;
    doctor)  cmd_doctor "$@" ;;
    version|--version|-V) cmd_version "$@" ;;
    help|--help|-h) usage ;;
    *) printf '%s\n' "${RED}sim: unknown command '${cmd}'${RST}" >&2; usage; exit 2 ;;
  esac
}
main "$@"
